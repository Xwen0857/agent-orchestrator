{
  "roles": {
    "planner-core": {
      "allowed_read_paths": [
        "projects"
      ]
    },
    "scheduler-ops": {
      "allowed_read_paths": [
        "projects"
      ]
    },
    "observer-bridge": {
      "allowed_read_paths": [
        "templates/coordination/tasks/task_folders",
        "templates/coordination/security/role_permissions.effective.json"
      ],
      "allowed_write_paths": [
        "templates/coordination/tasks/task_folders"
      ],
      "forbidden_paths": [
        "templates/coordination/planner/config",
        "templates/coordination/audit/policy",
        "templates/coordination/orchestrator",
        "projects"
      ]
    },
    "planner-ops": {
      "allowed_read_paths": [
        "projects"
      ]
    },
    "worker-delivery": {
      "allowed_read_paths": [
        "projects"
      ],
      "allowed_write_paths": [
        "projects"
      ],
      "forbidden_paths": [
        "projects/*/runs/*/.openclaw-system",
        "projects/*/runs/*/agent_runtime_profiles.json",
        "templates/coordination/orchestrator",
        "templates/coordination/security"
      ]
    },
    "tester-ephemeral": {
      "allowed_read_paths": [
        "projects"
      ],
      "allowed_write_paths": [
        "projects"
      ],
      "forbidden_paths": [
        "projects/*/runs/*/.openclaw-system",
        "projects/*/runs/*/agent_runtime_profiles.json",
        "templates/coordination/orchestrator",
        "templates/coordination/security"
      ]
    },
    "audit-guard": {
      "allowed_read_paths": [
        "projects"
      ]
    }
  }
}
