{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.local/schemas/task-meta.schema.json",
  "title": "TaskMeta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "state",
    "stage",
    "owner",
    "risk_level",
    "version",
    "budget",
    "created_at",
    "updated_at",
    "parents",
    "artifacts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^task_[a-zA-Z0-9._-]+$"
    },
    "state": {
      "type": "string",
      "enum": [
        "CREATED",
        "PLANNED",
        "ASSIGNED",
        "IN_PROGRESS",
        "TESTING",
        "APPROVED",
        "REJECTED",
        "BLOCKED_AWAITING_CLARIFICATION",
        "BLOCKED_PENDING_APPROVAL",
        "BLOCKED_SYSTEM_ERROR",
        "CLOSED"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "INTAKE",
        "PLANNING",
        "DELIVERY",
        "TEST",
        "AUDIT",
        "GOVERNANCE",
        "COMPLETE"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_token_cost",
        "max_execution_time_seconds"
      ],
      "properties": {
        "max_token_cost": {
          "type": "integer",
          "minimum": 1
        },
        "max_execution_time_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "consumption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token_cost_used": {
          "type": "integer",
          "minimum": 0
        },
        "execution_time_used_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "external_calls_used": {
          "type": "integer",
          "minimum": 0
        }
      },
      "default": {
        "token_cost_used": 0,
        "execution_time_used_seconds": 0,
        "external_calls_used": 0
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          }
        }
      }
    },
    "last_approval_id": {
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "knowledge_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "planner_replan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "applied",
            "resolved"
          ]
        },
        "impact": {
          "type": "string",
          "enum": [
            "soft",
            "refresh_required",
            "hard"
          ]
        },
        "worker_policy": {
          "type": "string",
          "enum": [
            "continue",
            "revalidate_then_resume",
            "pause_and_require_replan"
          ]
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "applied_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope_summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "latest_effective_patch_path": {
          "type": "string"
        },
        "latest_amendment_batch_path": {
          "type": "string"
        }
      }
    },
    "runtime_replan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consume_status": {
          "type": "string",
          "enum": [
            "pending_consume",
            "ready",
            "awaiting_revalidation",
            "paused"
          ]
        },
        "consumed_at": {
          "type": "string",
          "format": "date-time"
        },
        "resumed_at": {
          "type": "string",
          "format": "date-time"
        },
        "blocked_reason": {
          "type": "string"
        },
        "last_runtime_actor": {
          "type": "string"
        },
        "last_runtime_transition": {
          "type": "string"
        },
        "source_planner_requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_planner_policy": {
          "type": "string"
        },
        "source_planner_impact": {
          "type": "string"
        }
      }
    }
  }
}
