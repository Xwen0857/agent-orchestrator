{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.local/schemas/task-meta.schema.json",
  "title": "TaskMeta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "state",
    "stage",
    "owner",
    "risk_level",
    "version",
    "budget",
    "created_at",
    "updated_at",
    "parents",
    "artifacts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^task_[a-zA-Z0-9._-]+$"
    },
    "state": {
      "type": "string",
      "enum": [
        "CREATED",
        "PLANNED",
        "ASSIGNED",
        "IN_PROGRESS",
        "TESTING",
        "APPROVED",
        "REJECTED",
        "BLOCKED_AWAITING_CLARIFICATION",
        "BLOCKED_PENDING_APPROVAL",
        "BLOCKED_SYSTEM_ERROR",
        "CLOSED"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "INTAKE",
        "PLANNING",
        "DELIVERY",
        "TEST",
        "AUDIT",
        "GOVERNANCE",
        "COMPLETE"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_token_cost",
        "max_execution_time_seconds"
      ],
      "properties": {
        "max_token_cost": {
          "type": "integer",
          "minimum": 1
        },
        "max_execution_time_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "consumption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token_cost_used": {
          "type": "integer",
          "minimum": 0
        },
        "execution_time_used_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "external_calls_used": {
          "type": "integer",
          "minimum": 0
        }
      },
      "default": {
        "token_cost_used": 0,
        "execution_time_used_seconds": 0,
        "external_calls_used": 0
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          }
        }
      }
    },
    "last_approval_id": {
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "knowledge_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "planner_replan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "applied",
            "resolved"
          ]
        },
        "impact": {
          "type": "string",
          "enum": [
            "soft",
            "refresh_required",
            "hard"
          ]
        },
        "worker_policy": {
          "type": "string",
          "enum": [
            "continue",
            "revalidate_then_resume",
            "pause_and_require_replan"
          ]
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "applied_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope_summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "latest_effective_patch_path": {
          "type": "string"
        },
        "latest_amendment_batch_path": {
          "type": "string"
        }
      }
    },
    "runtime_replan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consume_status": {
          "type": "string",
          "enum": [
            "pending_consume",
            "ready",
            "awaiting_revalidation",
            "paused"
          ]
        },
        "consumed_at": {
          "type": "string",
          "format": "date-time"
        },
        "resumed_at": {
          "type": "string",
          "format": "date-time"
        },
        "blocked_reason": {
          "type": "string"
        },
        "last_runtime_actor": {
          "type": "string"
        },
        "last_runtime_transition": {
          "type": "string"
        },
        "source_planner_requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_planner_policy": {
          "type": "string"
        },
        "source_planner_impact": {
          "type": "string"
        }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime_view_path": {
          "type": "string"
        },
        "runtime_page_id": {
          "type": "string"
        },
        "terminal_digest_path": {
          "type": "string"
        },
        "terminal_page_id": {
          "type": "string"
        },
        "raw_log_index_path": {
          "type": "string"
        },
        "terminal_last_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "terminal_lifecycle_result": {
          "type": "string"
        },
        "bridge_packet_path": {
          "type": "string"
        },
        "bridge_last_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "bridge_last_fingerprint": {
          "type": "string"
        },
        "bridge_last_request_id": {
          "type": "string"
        },
        "bridge_last_consumed_at": {
          "type": "string",
          "format": "date-time"
        },
        "bridge_last_consumed_fingerprint": {
          "type": "string"
        },
        "bridge_last_consumed_request_id": {
          "type": "string"
        }
      }
    },
    "worker_runtime": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "assembled_at": {
          "type": "string"
        },
        "role_type": {
          "type": "string"
        },
        "selected_template_id": {
          "type": "string"
        },
        "selected_template_origin": {
          "type": "string",
          "enum": [
            "builtin",
            "custom"
          ]
        },
        "selected_template_source_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        },
        "registration_source": {
          "type": "string"
        },
        "governance_policy_id": {
          "type": "string"
        },
        "result_contract_version": {
          "type": "string"
        },
        "allowed_template_origins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "custom_registration_required": {
          "type": "boolean"
        },
        "default_message_type": {
          "type": "string"
        },
        "refinement_route_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "module_id": {
              "type": "string"
            },
            "refinement_task_id": {
              "type": "string"
            }
          }
        },
        "milestone_set": {
          "type": "object",
          "additionalProperties": true
        },
        "milestone_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "milestone_completed_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "milestone_progress_signal": {
          "type": "object",
          "additionalProperties": true
        },
        "milestone_completion_signal": {
          "type": "object",
          "additionalProperties": true
        },
        "milestone_detection_window_seconds": {
          "type": "number"
        },
        "stage_write_stagnation_seconds": {
          "type": "number"
        },
        "all_milestones_met": {
          "type": "boolean"
        },
        "keeper_query_path": {
          "type": "string"
        },
        "failure_pattern_summary_path": {
          "type": "string"
        },
        "failure_pattern_index_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_pattern_read_contract": {
          "type": "object",
          "additionalProperties": true
        },
        "custom_template_registrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "custom_coarse_template_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "semantic_topology": {
          "type": "object",
          "additionalProperties": true
        },
        "implementation_topology": {
          "type": "object",
          "additionalProperties": true
        },
        "cluster_projection": {
          "type": "object",
          "additionalProperties": true
        },
        "custom_runtime_gate_status": {
          "type": "string"
        },
        "custom_capability_gate_reason": {
          "type": "string"
        }
      }
    },
    "worker_stage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "worker_stage_id": {
          "type": "string"
        },
        "worker_stage_root": {
          "type": "string"
        },
        "worker_stage_profile": {
          "type": "string"
        },
        "stage_isolation_mode": {
          "type": "string"
        },
        "stage_runtime_class": {
          "type": "string"
        },
        "allowed_execution_mode": {
          "type": "string"
        },
        "allocation": {
          "type": "object",
          "additionalProperties": true
        },
        "retention": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "worker_budget": {
      "type": "object",
      "additionalProperties": true
    },
    "worker_convergence": {
      "type": "object",
      "additionalProperties": true
    },
    "task_cluster": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "last_published_message_type": {
          "type": "string"
        }
      }
    },
    "runtime_worker_control": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "budget_status": {
          "type": "string"
        },
        "reclaim_requested_at": {
          "type": "string"
        },
        "rebuild_ready": {
          "type": "boolean"
        },
        "rebuild_reason": {
          "type": "string"
        },
        "last_rebuilt_at": {
          "type": "string"
        },
        "last_worker_fault_action": {
          "type": "string"
        },
        "worker_fault_retryable": {
          "type": "boolean"
        },
        "worker_fault_requires_rebuild": {
          "type": "boolean"
        },
        "last_fault_action_applied": {
          "type": "string"
        },
        "fault_actuation_mode": {
          "type": "string"
        },
        "fault_action_blocked_by_policy": {
          "type": "boolean"
        },
        "worker_fault_class": {
          "type": "string"
        },
        "archive_ready": {
          "type": "boolean"
        },
        "reclaim_ready": {
          "type": "boolean"
        },
        "purge_ready": {
          "type": "boolean"
        },
        "retention_decision": {
          "type": "string"
        }
      }
    },
    "keeper_feedback": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
